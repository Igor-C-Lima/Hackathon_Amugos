{
  "hosting": {
    "public": ".output/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "server",
          "region": "southamerica-east1",
          "pinTag": true
        }
      }
    ]
  },
  "functions": {
    "source": ".output/server"
  }
}
