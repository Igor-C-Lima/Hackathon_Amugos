FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_auth_domain
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# watsonx Orchestrate
WATSONX_API_KEY=your_watsonx_api_key
WATSONX_SERVICE_URL=https://api.your-region.watson-orchestrate.ibm.com/instances/your_instance_id
WATSONX_AGENT_ID=your_agent_id

# Embrapa AgroAPI (ClimAPI, Agritec)
# Consumer key/secret do app cadastrado no portal da AgroAPI — o token
# de acesso é gerado e renovado automaticamente a partir deles.
AGROAPI_CONSUMER_KEY=your_agroapi_consumer_key
AGROAPI_CONSUMER_SECRET=your_agroapi_consumer_secret
